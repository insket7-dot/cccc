{
    "name": "cross-platform-app",
    "version": "0.0.0",
    "packageManager": "pnpm@10.18.1",
    "scripts": {
        "start:prod": "ng serve --configuration=production",
        "start:mock": "ng serve --configuration=mock",
        "start:dev": "ng serve --configuration=dev  --proxy-config proxy.conf.json --host 0.0.0.0 --port 56771",
        "prettier": "npx prettier --write ./src",
        "build:dev": "ng build -c dev && npm run sync",
        "build:prod": "ng build -c production && npm run sync",
        "sync": "npx cap sync",
        "watch": "ng build --watch --configuration dev",
        "test": "ng test",
        "lint": "ng lint"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "engines": {
        "node": ">=22",
        "pnpm": ">=10"
    },
    "dependencies": {
        "@angular/animations": "^20.3.4",
        "@angular/cdk": "^20.2.8",
        "@angular/common": "^20.3.4",
        "@angular/compiler": "^20.3.4",
        "@angular/core": "^20.3.4",
        "@angular/forms": "^20.3.4",
        "@angular/material": "^20.2.8",
        "@angular/material-moment-adapter": "^20.2.8",
        "@angular/platform-browser": "^20.3.4",
        "@angular/router": "^20.3.4",
        "@capacitor-community/sqlite": "^7.0.1",
        "@capacitor-mlkit/barcode-scanning": "^7.3.0",
        "@capacitor-rydeen/mqtt": "^7.0.7",
        "@capacitor-rydeen/preferences": "^7.0.2",
        "@capacitor-rydeen/tools": "^8.0.6",
        "@capacitor/android": "^7.4.3",
        "@capacitor/app": "^7.1.0",
        "@capacitor/core": "^7.4.3",
        "@capacitor/keyboard": "~7.0.0",
        "@capacitor/status-bar": "~7.0.0",
        "@capgo/capacitor-updater": "~7.15.2",
        "@ionic/angular": "8.7.5",
        "@rydeen/angular-framework": "^20.0.0",
        "@rydeen/hotfix": "7.0.2",
        "@rydeen/logger": "^6.0.1",
        "jeep-sqlite": "^2.8.0",
        "kysely": "^0.28.7",
        "moment": "^2.30.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "~7.8.0",
        "sql.js": "1.11.0",
        "tslib": "^2.3.0",
        "uuid": "^13.0.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^20.3.5",
        "@angular/cli": "^20.3.5",
        "@angular/compiler-cli": "^20.3.4",
        "@capacitor/cli": "^7.4.3",
        "@ngx-translate/core": "^17.0.0",
        "@ngx-translate/http-loader": "^17.0.0",
        "@types/jasmine": "~5.1.0",
        "@types/node": "22.13.14",
        "jasmine-core": "~5.9.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "typescript": "~5.9.2",
        "vite": "^5.4.10"
    }
}
